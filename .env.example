# Kronos Market Desk — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
#
# Nothing here should ever be a trade- or withdraw-capable credential.
# This system is read-only market observation; it holds no broker keys.

# --- Model ---
KMD_MODEL_NAME=NeoQuasar/Kronos-small
KMD_TOKENIZER_NAME=NeoQuasar/Kronos-Tokenizer-base
KMD_MODEL_MAX_CONTEXT=512
KMD_DEVICE=cpu

# --- Forecast ---
KMD_LOOKBACK_BARS=400
KMD_PRED_LEN=24
KMD_MC_PATHS=30
KMD_TEMPERATURE=1.0
KMD_TOP_P=0.9
KMD_TOP_K=0
KMD_SEED=1337

# --- Data sources (optional; public endpoints work without keys) ---
# Only ever request read-only / market-data scopes if you do add keys.
KMD_CCXT_EXCHANGE=binance
KMD_CCXT_API_KEY=
KMD_CCXT_API_SECRET=

# --- Storage ---
KMD_DB_PATH=./data/kmd.sqlite3

# --- Server ---
KMD_HOST=127.0.0.1
KMD_PORT=8000

# --- Scheduler ---
KMD_REFRESH_TIMEFRAMES=1h,4h,1d

# --- Optional LLM day-summary (off by default; never used in data/metrics path) ---
KMD_ENABLE_LLM_SUMMARY=false
KMD_LLM_API_KEY=
